{{- $index := slice -}}
{{- range where site.RegularPages "Section" "in" (slice "gaming" "music") -}}
  {{- $index = $index | append (dict
    "title" .Title
    "permalink" .RelPermalink
    "summary" (.Summary | plainify | truncate 200)
    "date" (.Date.Format "2006-01-02")
    "tags" .Params.tags
    "content" (.Plain | truncate 500)
  ) -}}
{{- end -}}
{{- $index | jsonify -}}
